option(RR_NATIVE_TERRAIN_SANITIZERS "Require address/undefined terrain sanitizers" OFF)
add_library(racer_native_terrain_numeric STATIC
    src/game/collision_query48h.cpp src/game/collision_tree_workspace48m.cpp
    src/game/terrain_query_workspace48m.cpp src/game/terrain_prepare48m.cpp)
add_library(racer_native_terrain_fixture_support STATIC
    src/game/collision_tree48i.cpp src/game/terrain_query48j.cpp
    src/assets/import_collision48g.cpp src/assets/collision_runtime48h.cpp src/assets/collision_mesh48i.cpp)
target_link_libraries(racer_native_terrain_fixture_support PUBLIC racer_native_terrain_numeric)
set(rr_terrain_targets racer_native_terrain_numeric racer_native_terrain_fixture_support)
foreach(rr_test IN ITEMS collision_query48h collision_tree48i collision_workspace48m terrain_query48j terrain_workspace48m terrain_prepare48m)
    add_executable(racer_${rr_test}_check tests/native/${rr_test}.cpp)
    target_link_libraries(racer_${rr_test}_check PRIVATE racer_native_terrain_fixture_support)
    list(APPEND rr_terrain_targets racer_${rr_test}_check)
endforeach()
set_property(GLOBAL APPEND PROPERTY JOB_POOLS rr_terrain_serial=1)
foreach(rr_target IN LISTS rr_terrain_targets)
    target_include_directories(${rr_target} PUBLIC src/game src/assets)
    target_compile_features(${rr_target} PUBLIC cxx_std_17)
    set_target_properties(${rr_target} PROPERTIES CXX_EXTENSIONS OFF JOB_POOL_COMPILE rr_terrain_serial JOB_POOL_LINK rr_terrain_serial)
    if(MSVC)
        target_compile_options(${rr_target} PRIVATE /W4 /permissive- /fp:strict)
        if(RR_NATIVE_TERRAIN_SANITIZERS)
            message(FATAL_ERROR "This sanitizer option requires GCC/Clang; no silent fallback")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(${rr_target} PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -frounding-math -ffp-contract=off)
        if(RR_NATIVE_TERRAIN_SANITIZERS)
            target_compile_options(${rr_target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
            target_link_options(${rr_target} PRIVATE -fsanitize=address,undefined)
        endif()
    else()
        message(FATAL_ERROR "Explicit strict floating-point compiler settings are required")
    endif()
endforeach()
enable_testing()
foreach(rr_test IN ITEMS collision_query48h collision_tree48i collision_workspace48m terrain_query48j terrain_workspace48m terrain_prepare48m)
    add_test(NAME ${rr_test} COMMAND racer_${rr_test}_check ${CMAKE_SOURCE_DIR})
    set_tests_properties(${rr_test} PROPERTIES RUN_SERIAL TRUE TIMEOUT 120)
endforeach()
