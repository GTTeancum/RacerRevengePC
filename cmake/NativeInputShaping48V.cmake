# Focused portable input extraction only; no collision/renderer/importer dependency.
option(RR_NATIVE_INPUT_SHAPING_SANITIZERS "Require address/undefined sanitizers" OFF)
add_library(racer_native_input_shaping STATIC src/game/control_filter48b.cpp src/game/control_shaping48v.cpp)
set(rr_input_targets racer_native_input_shaping)
foreach(rr_test IN ITEMS control_shaping48v control_filter48b)
    add_executable(racer_${rr_test}_check tests/native/${rr_test}.cpp)
    target_link_libraries(racer_${rr_test}_check PRIVATE racer_native_input_shaping)
    list(APPEND rr_input_targets racer_${rr_test}_check)
endforeach()
foreach(rr_target IN LISTS rr_input_targets)
    target_include_directories(${rr_target} PUBLIC src/game)
    target_compile_features(${rr_target} PUBLIC cxx_std_17)
    set_target_properties(${rr_target} PROPERTIES CXX_EXTENSIONS OFF)
    if(MSVC)
        target_compile_options(${rr_target} PRIVATE /W4 /permissive- /fp:strict)
        if(RR_NATIVE_INPUT_SHAPING_SANITIZERS)
            message(FATAL_ERROR "This sanitizer option requires GCC/Clang; no silent fallback")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(${rr_target} PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -frounding-math -ffp-contract=off)
        if(RR_NATIVE_INPUT_SHAPING_SANITIZERS)
            target_compile_options(${rr_target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
            target_link_options(${rr_target} PRIVATE -fsanitize=address,undefined)
        endif()
    else()
        message(FATAL_ERROR "Explicit strict floating-point compiler settings are required")
    endif()
endforeach()
enable_testing()
foreach(rr_test IN ITEMS control_shaping48v control_filter48b)
    add_test(NAME ${rr_test} COMMAND racer_${rr_test}_check)
    set_tests_properties(${rr_test} PROPERTIES RUN_SERIAL TRUE TIMEOUT 120)
endforeach()
