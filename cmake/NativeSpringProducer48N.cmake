# Focused portable spring-record production; no renderer/importer dependency.
option(RR_NATIVE_SPRING_PRODUCER_SANITIZERS "Require address/undefined sanitizers" OFF)
foreach(rr_fixture IN ITEMS
        evidence/springRecords48N/native-fixtures.json
        evidence/springCallback48N/static-callback-fixtures.bin
        evidence/springQuery48N/native-fixtures.json)
    if(NOT EXISTS "${CMAKE_SOURCE_DIR}/${rr_fixture}")
        message(FATAL_ERROR "BLOCKED: required original-derived spring producer fixture is missing: ${rr_fixture}")
    endif()
endforeach()
add_library(racer_native_spring_producer STATIC
    src/game/collision_query48h.cpp src/game/collision_tree_workspace48m.cpp
    src/game/spring_records48n.cpp src/game/spring_callback48n.cpp src/game/spring_query48n.cpp)
set(rr_producer_targets racer_native_spring_producer)
foreach(rr_test IN ITEMS spring_records48n spring_callback48n spring_query48n)
    add_executable(racer_${rr_test}_check tests/native/${rr_test}.cpp)
    target_link_libraries(racer_${rr_test}_check PRIVATE racer_native_spring_producer)
    target_include_directories(racer_${rr_test}_check PRIVATE third_party/native-json)
    list(APPEND rr_producer_targets racer_${rr_test}_check)
endforeach()
set_property(GLOBAL APPEND PROPERTY JOB_POOLS rr_spring_producer_serial=1)
foreach(rr_target IN LISTS rr_producer_targets)
    target_include_directories(${rr_target} PUBLIC src/game src/assets)
    target_compile_features(${rr_target} PUBLIC cxx_std_17)
    set_target_properties(${rr_target} PROPERTIES CXX_EXTENSIONS OFF JOB_POOL_COMPILE rr_spring_producer_serial JOB_POOL_LINK rr_spring_producer_serial)
    if(MSVC)
        target_compile_options(${rr_target} PRIVATE /W4 /permissive- /fp:strict)
        if(RR_NATIVE_SPRING_PRODUCER_SANITIZERS)
            message(FATAL_ERROR "This sanitizer option requires GCC/Clang; no silent fallback")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(${rr_target} PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -frounding-math -ffp-contract=off)
        if(RR_NATIVE_SPRING_PRODUCER_SANITIZERS)
            target_compile_options(${rr_target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
            target_link_options(${rr_target} PRIVATE -fsanitize=address,undefined)
        endif()
    else()
        message(FATAL_ERROR "Explicit strict floating-point compiler settings are required")
    endif()
endforeach()
enable_testing()
foreach(rr_test IN ITEMS spring_records48n spring_callback48n spring_query48n)
    add_test(NAME ${rr_test} COMMAND racer_${rr_test}_check ${CMAKE_SOURCE_DIR})
    set_tests_properties(${rr_test} PROPERTIES RUN_SERIAL TRUE TIMEOUT 120)
endforeach()
