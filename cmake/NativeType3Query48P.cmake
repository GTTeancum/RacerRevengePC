# Focused portable bounded type3 query; no renderer dependency.
option(RR_NATIVE_TYPE3_SANITIZERS "Require address/undefined sanitizers" OFF)
foreach(rr_fixture IN ITEMS
        evidence/springCallback48P/static-type3-callback-fixtures.bin
        evidence/type3Leaf48P/leaf-fixtures.bin
        evidence/type3Node48P/sphere-fixtures.bin
        evidence/type3Node48P/ray-fixtures.bin
        evidence/type3Query48P/native-fixtures.json)
    if(NOT EXISTS "${CMAKE_SOURCE_DIR}/${rr_fixture}")
        message(FATAL_ERROR "BLOCKED: required original-derived type3 fixture is missing: ${rr_fixture}")
    endif()
endforeach()
add_library(racer_native_type3 STATIC
    src/game/spring_records48n.cpp src/game/spring_callback48n.cpp
    src/game/spring_type3_callback48p.cpp src/game/collision_type3_leaf48p.cpp
    src/game/collision_type3_node48p.cpp src/game/type3_prepare48p.cpp src/game/type3_query48p.cpp)
set(rr_type3_targets racer_native_type3)
foreach(rr_test IN ITEMS spring_type3_callback48p collision_type3_leaf48p collision_type3_node48p type3_prepare48p type3_query48p)
    add_executable(racer_${rr_test}_check tests/native/${rr_test}.cpp)
    target_link_libraries(racer_${rr_test}_check PRIVATE racer_native_type3)
    target_include_directories(racer_${rr_test}_check PRIVATE third_party/native-json)
    list(APPEND rr_type3_targets racer_${rr_test}_check)
endforeach()
set_property(GLOBAL APPEND PROPERTY JOB_POOLS rr_type3_serial=1)
foreach(rr_target IN LISTS rr_type3_targets)
    target_include_directories(${rr_target} PUBLIC src/game src/assets)
    target_compile_features(${rr_target} PUBLIC cxx_std_17)
    set_target_properties(${rr_target} PROPERTIES CXX_EXTENSIONS OFF JOB_POOL_COMPILE rr_type3_serial JOB_POOL_LINK rr_type3_serial)
    if(MSVC)
        target_compile_options(${rr_target} PRIVATE /W4 /permissive- /fp:strict)
        if(RR_NATIVE_TYPE3_SANITIZERS)
            message(FATAL_ERROR "This sanitizer option requires GCC/Clang; no silent fallback")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(${rr_target} PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -frounding-math -ffp-contract=off)
        if(RR_NATIVE_TYPE3_SANITIZERS)
            target_compile_options(${rr_target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
            target_link_options(${rr_target} PRIVATE -fsanitize=address,undefined)
        endif()
    else()
        message(FATAL_ERROR "Explicit strict floating-point compiler settings are required")
    endif()
endforeach()
enable_testing()
foreach(rr_test IN ITEMS spring_type3_callback48p collision_type3_leaf48p collision_type3_node48p type3_prepare48p type3_query48p)
    set(rr_argument "${CMAKE_SOURCE_DIR}")
    if(rr_test STREQUAL "collision_type3_leaf48p")
        set(rr_argument "${CMAKE_SOURCE_DIR}/evidence/type3Leaf48P/leaf-fixtures.bin")
    elseif(rr_test STREQUAL "collision_type3_node48p")
        set(rr_argument "${CMAKE_SOURCE_DIR}/evidence/type3Node48P")
    endif()
    add_test(NAME ${rr_test} COMMAND racer_${rr_test}_check ${rr_argument})
    set_tests_properties(${rr_test} PROPERTIES RUN_SERIAL TRUE TIMEOUT 120)
endforeach()
