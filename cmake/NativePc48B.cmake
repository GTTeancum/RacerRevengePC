# Explicit native source list. Do not include the compatibility-runtime hooks.
if(NOT WIN32 OR NOT MSVC)
    message(FATAL_ERROR "Native PC 48B currently requires Windows and MSVC")
endif()
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
add_library(racer_native_assets STATIC src/assets/native_asset48b.cpp)
target_include_directories(racer_native_assets PUBLIC src/assets)
target_compile_features(racer_native_assets PUBLIC cxx_std_17)
add_executable(racer_native_pc platform/windows/native/main48b.cpp)
target_compile_definitions(racer_native_pc PRIVATE UNICODE _UNICODE)
target_link_libraries(racer_native_pc PRIVATE racer_native_assets
    d3d11 dxgi d3dcompiler user32 gdi32 psapi)
add_executable(racer_native_asset_check tests/native/asset_loader48b.cpp)
target_link_libraries(racer_native_asset_check PRIVATE racer_native_assets)
foreach(rr_native_target IN ITEMS racer_native_assets racer_native_pc racer_native_asset_check)
    target_compile_options(${rr_native_target} PRIVATE /W4 /permissive- /fp:precise)
    target_compile_definitions(${rr_native_target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
endforeach()
target_link_options(racer_native_pc PRIVATE "/MAP:${CMAKE_BINARY_DIR}/racer_native_pc.map")
enable_testing()
add_test(NAME native_asset_loader COMMAND racer_native_asset_check)
add_library(racer_native_game STATIC src/game/control_filter48b.cpp)
target_include_directories(racer_native_game PUBLIC src/game)
target_compile_features(racer_native_game PUBLIC cxx_std_17)
add_executable(racer_native_control_check tests/native/control_filter48b.cpp)
target_link_libraries(racer_native_control_check PRIVATE racer_native_game)
foreach(rr_control_target IN ITEMS racer_native_game racer_native_control_check)
    target_compile_options(${rr_control_target} PRIVATE /W4 /permissive- /fp:strict)
endforeach()
add_test(NAME native_control_filter COMMAND racer_native_control_check)
