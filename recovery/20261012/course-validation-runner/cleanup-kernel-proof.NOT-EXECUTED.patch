+def kernel_no_children():
+    # Call only after Popen has handled its phase leader, or during final
+    # terminal cleanup when no Popen result remains to be consumed. A /proc
+    # snapshot can race reparenting; verified subreaper + kernel ECHILD cannot.
+    reaped = []
+    for _ in range(65536):
+        try:
+            pid, status = os.waitpid(-1, os.WNOHANG)
+        except ChildProcessError:
+            return {'kernel_waitpid_echild':True, 'reaped':reaped}
+        if pid == 0:
+            return {'kernel_waitpid_echild':False, 'reaped':reaped}
+        reaped.append({'pid':pid, 'wait_status':status})
+    return {'kernel_waitpid_echild':False, 'reaped':reaped[:128], 'reap_bound_reached':True}
+
