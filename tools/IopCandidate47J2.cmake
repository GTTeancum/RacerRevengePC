set(rr_iop47j2 "${CMAKE_CURRENT_LIST_DIR}/../build/iop47J2")
file(READ "${rr_iop47j2}/CMakeLists.txt" rr_iop47j2_cmake)
string(REGEX MATCHALL "src/[A-Za-z0-9_/]+[.]cpp" rr_iop47j2_sources "${rr_iop47j2_cmake}")
list(REMOVE_DUPLICATES rr_iop47j2_sources)
list(LENGTH rr_iop47j2_sources rr_iop47j2_count)
if(NOT rr_iop47j2_count EQUAL 24)
    message(FATAL_ERROR "IOP clone must contain exactly the original 24 implementation files")
endif()
list(TRANSFORM rr_iop47j2_sources PREPEND "${rr_iop47j2}/")
add_library(rr_iop47j2 OBJECT ${rr_iop47j2_sources})
target_compile_features(rr_iop47j2 PUBLIC cxx_std_20)
target_include_directories(rr_iop47j2 PUBLIC "${rr_iop47j2}/include" PRIVATE "${rr_iop47j2}/src" "${CMAKE_CURRENT_LIST_DIR}/../src/core")
if(TARGET ps2_iop)
    target_compile_options(rr_iop47j2 PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_OPTIONS>")
    target_compile_definitions(rr_iop47j2 PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_DEFINITIONS>")
elseif(MSVC)
    target_compile_options(rr_iop47j2 PRIVATE /O2 /EHsc)
    target_compile_definitions(rr_iop47j2 PRIVATE PS2X_ENABLE_IOP_RPC_TRACE=1)
endif()
add_executable(racer_iop47j2_differential "${rr_iop47j2}/differential47j2.cpp")
target_include_directories(racer_iop47j2_differential PRIVATE "${rr_iop47j2}/src" "${rr_iop47j2}/src/emulator" "${rr_iop47j2}/tests")
target_link_libraries(racer_iop47j2_differential PRIVATE rr_iop47j2)
add_executable(racer_iop47j2_scheduler "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_scheduler47g.cpp")
target_include_directories(racer_iop47j2_scheduler PRIVATE "${rr_iop47j2}/src")
target_link_libraries(racer_iop47j2_scheduler PRIVATE rr_iop47j2)
foreach(rr_suite IN ITEMS emulator import import_version compatibility)
    add_executable(racer_iop47j2_${rr_suite} "${rr_iop47j2}/tests/iop_${rr_suite}_tests.cpp")
    target_include_directories(racer_iop47j2_${rr_suite} PRIVATE "${rr_iop47j2}/src")
    target_link_libraries(racer_iop47j2_${rr_suite} PRIVATE rr_iop47j2)
endforeach()
if(TARGET ps2_runtime)
    add_executable(racer_iop47j2_fixed_probe "${RACER_PROJECT_DIR}/src/probe.cpp"
        "${RR_SHARED_ROOT}/build/fixed47F/EeScheduler.cpp")
    target_include_directories(racer_iop47j2_fixed_probe PRIVATE
        "${RR_SHARED_ROOT}/src/legacy" "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib"
        "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib/Kernel")
    target_link_libraries(racer_iop47j2_fixed_probe PRIVATE racer_generated ps2_runtime rr_iop47j2)
    ps2x_stage_ffmpeg_runtime_dlls(racer_iop47j2_fixed_probe)
endif()

target_include_directories(rr_iop47j2 PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../src/core")
add_executable(racer_iop47j2_import_cache "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_import_cache47i.cpp")
target_include_directories(racer_iop47j2_import_cache PRIVATE "${rr_iop47j2}/src")
target_link_libraries(racer_iop47j2_import_cache PRIVATE rr_iop47j2)

add_executable(racer_iop47j2_memory "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_ownership47j.cpp" "${rr_iop47j2}/memory_reference47j.cpp")
target_include_directories(racer_iop47j2_memory PRIVATE "${rr_iop47j2}" "${rr_iop47j2}/src")
target_link_libraries(racer_iop47j2_memory PRIVATE rr_iop47j2)
target_compile_definitions(racer_iop47j2_memory PRIVATE RR_OWNERSHIP_LIFETIME_GUARD)
