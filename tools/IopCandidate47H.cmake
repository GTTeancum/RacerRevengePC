set(rr_iop47h "${CMAKE_CURRENT_LIST_DIR}/../build/iop47H")
file(READ "${rr_iop47h}/CMakeLists.txt" rr_iop47h_cmake)
string(REGEX MATCHALL "src/[A-Za-z0-9_/]+[.]cpp" rr_iop47h_sources "${rr_iop47h_cmake}")
list(REMOVE_DUPLICATES rr_iop47h_sources)
list(LENGTH rr_iop47h_sources rr_iop47h_count)
if(NOT rr_iop47h_count EQUAL 24)
    message(FATAL_ERROR "IOP clone must contain exactly the original 24 implementation files")
endif()
list(TRANSFORM rr_iop47h_sources PREPEND "${rr_iop47h}/")
add_library(rr_iop47h OBJECT ${rr_iop47h_sources})
target_compile_features(rr_iop47h PUBLIC cxx_std_20)
target_include_directories(rr_iop47h PUBLIC "${rr_iop47h}/include" PRIVATE "${rr_iop47h}/src" "${CMAKE_CURRENT_LIST_DIR}/../src/core")
if(TARGET ps2_iop)
    target_compile_options(rr_iop47h PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_OPTIONS>")
    target_compile_definitions(rr_iop47h PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_DEFINITIONS>")
elseif(MSVC)
    target_compile_options(rr_iop47h PRIVATE /O2 /EHsc)
    target_compile_definitions(rr_iop47h PRIVATE PS2X_ENABLE_IOP_RPC_TRACE=1)
endif()
add_executable(racer_iop47h_differential "${rr_iop47h}/differential47h.cpp")
target_include_directories(racer_iop47h_differential PRIVATE "${rr_iop47h}/src" "${rr_iop47h}/src/emulator" "${rr_iop47h}/tests")
target_link_libraries(racer_iop47h_differential PRIVATE rr_iop47h)
add_executable(racer_iop47h_scheduler "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_scheduler47g.cpp")
target_include_directories(racer_iop47h_scheduler PRIVATE "${rr_iop47h}/src")
target_link_libraries(racer_iop47h_scheduler PRIVATE rr_iop47h)
foreach(rr_suite IN ITEMS emulator import import_version compatibility)
    add_executable(racer_iop47h_${rr_suite} "${rr_iop47h}/tests/iop_${rr_suite}_tests.cpp")
    target_include_directories(racer_iop47h_${rr_suite} PRIVATE "${rr_iop47h}/src")
    target_link_libraries(racer_iop47h_${rr_suite} PRIVATE rr_iop47h)
endforeach()
if(TARGET ps2_runtime)
    add_executable(racer_iop47h_fixed_probe "${RACER_PROJECT_DIR}/src/probe.cpp"
        "${RR_SHARED_ROOT}/build/fixed47F/EeScheduler.cpp")
    target_include_directories(racer_iop47h_fixed_probe PRIVATE
        "${RR_SHARED_ROOT}/src/legacy" "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib"
        "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib/Kernel")
    target_link_libraries(racer_iop47h_fixed_probe PRIVATE racer_generated ps2_runtime rr_iop47h)
    ps2x_stage_ffmpeg_runtime_dlls(racer_iop47h_fixed_probe)
endif()
