set(rr_iop47g "${CMAKE_CURRENT_LIST_DIR}/../build/iop47G")
file(READ "${rr_iop47g}/CMakeLists.txt" rr_iop47g_cmake)
string(REGEX MATCHALL "src/[A-Za-z0-9_/]+[.]cpp" rr_iop47g_sources "${rr_iop47g_cmake}")
list(REMOVE_DUPLICATES rr_iop47g_sources)
list(LENGTH rr_iop47g_sources rr_iop47g_count)
if(NOT rr_iop47g_count EQUAL 24)
    message(FATAL_ERROR "IOP clone must contain exactly the original 24 implementation files")
endif()
list(TRANSFORM rr_iop47g_sources PREPEND "${rr_iop47g}/")
add_library(rr_iop47g OBJECT ${rr_iop47g_sources})
target_compile_features(rr_iop47g PUBLIC cxx_std_20)
target_include_directories(rr_iop47g PUBLIC "${rr_iop47g}/include" PRIVATE "${rr_iop47g}/src" "${CMAKE_CURRENT_LIST_DIR}/../src/core")
if(TARGET ps2_iop)
    target_compile_options(rr_iop47g PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_OPTIONS>")
    target_compile_definitions(rr_iop47g PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_DEFINITIONS>")
elseif(MSVC)
    target_compile_options(rr_iop47g PRIVATE /O2 /EHsc)
    target_compile_definitions(rr_iop47g PRIVATE PS2X_ENABLE_IOP_RPC_TRACE=1)
endif()
add_executable(racer_iop47g_differential "${rr_iop47g}/differential47g.cpp")
target_include_directories(racer_iop47g_differential PRIVATE "${rr_iop47g}/src" "${rr_iop47g}/src/emulator" "${rr_iop47g}/tests")
target_link_libraries(racer_iop47g_differential PRIVATE rr_iop47g)
add_executable(racer_iop47g_scheduler "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_scheduler47g.cpp")
target_include_directories(racer_iop47g_scheduler PRIVATE "${rr_iop47g}/src")
target_link_libraries(racer_iop47g_scheduler PRIVATE rr_iop47g)
foreach(rr_suite IN ITEMS emulator import import_version compatibility)
    add_executable(racer_iop47g_${rr_suite} "${rr_iop47g}/tests/iop_${rr_suite}_tests.cpp")
    target_include_directories(racer_iop47g_${rr_suite} PRIVATE "${rr_iop47g}/src")
    target_link_libraries(racer_iop47g_${rr_suite} PRIVATE rr_iop47g)
endforeach()
if(TARGET ps2_runtime)
    add_executable(racer_iop47g_fixed_probe "${RACER_PROJECT_DIR}/src/probe.cpp"
        "${RR_SHARED_ROOT}/build/fixed47F/EeScheduler.cpp")
    target_include_directories(racer_iop47g_fixed_probe PRIVATE
        "${RR_SHARED_ROOT}/src/legacy" "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib"
        "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib/Kernel")
    target_link_libraries(racer_iop47g_fixed_probe PRIVATE racer_generated ps2_runtime rr_iop47g)
    ps2x_stage_ffmpeg_runtime_dlls(racer_iop47g_fixed_probe)
endif()
