set(rr_iop47i "${CMAKE_CURRENT_LIST_DIR}/../build/iop47I")
file(READ "${rr_iop47i}/CMakeLists.txt" rr_iop47i_cmake)
string(REGEX MATCHALL "src/[A-Za-z0-9_/]+[.]cpp" rr_iop47i_sources "${rr_iop47i_cmake}")
list(REMOVE_DUPLICATES rr_iop47i_sources)
list(LENGTH rr_iop47i_sources rr_iop47i_count)
if(NOT rr_iop47i_count EQUAL 24)
    message(FATAL_ERROR "IOP clone must contain exactly the original 24 implementation files")
endif()
list(TRANSFORM rr_iop47i_sources PREPEND "${rr_iop47i}/")
add_library(rr_iop47i OBJECT ${rr_iop47i_sources})
target_compile_features(rr_iop47i PUBLIC cxx_std_20)
target_include_directories(rr_iop47i PUBLIC "${rr_iop47i}/include" PRIVATE "${rr_iop47i}/src" "${CMAKE_CURRENT_LIST_DIR}/../src/core")
if(TARGET ps2_iop)
    target_compile_options(rr_iop47i PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_OPTIONS>")
    target_compile_definitions(rr_iop47i PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_DEFINITIONS>")
elseif(MSVC)
    target_compile_options(rr_iop47i PRIVATE /O2 /EHsc)
    target_compile_definitions(rr_iop47i PRIVATE PS2X_ENABLE_IOP_RPC_TRACE=1)
endif()
add_executable(racer_iop47i_differential "${rr_iop47i}/differential47i.cpp")
target_include_directories(racer_iop47i_differential PRIVATE "${rr_iop47i}/src" "${rr_iop47i}/src/emulator" "${rr_iop47i}/tests")
target_link_libraries(racer_iop47i_differential PRIVATE rr_iop47i)
add_executable(racer_iop47i_scheduler "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_scheduler47g.cpp")
target_include_directories(racer_iop47i_scheduler PRIVATE "${rr_iop47i}/src")
target_link_libraries(racer_iop47i_scheduler PRIVATE rr_iop47i)
foreach(rr_suite IN ITEMS emulator import import_version compatibility)
    add_executable(racer_iop47i_${rr_suite} "${rr_iop47i}/tests/iop_${rr_suite}_tests.cpp")
    target_include_directories(racer_iop47i_${rr_suite} PRIVATE "${rr_iop47i}/src")
    target_link_libraries(racer_iop47i_${rr_suite} PRIVATE rr_iop47i)
endforeach()
if(TARGET ps2_runtime)
    add_executable(racer_iop47i_fixed_probe "${RACER_PROJECT_DIR}/src/probe.cpp"
        "${RR_SHARED_ROOT}/build/fixed47F/EeScheduler.cpp")
    target_include_directories(racer_iop47i_fixed_probe PRIVATE
        "${RR_SHARED_ROOT}/src/legacy" "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib"
        "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib/Kernel")
    target_link_libraries(racer_iop47i_fixed_probe PRIVATE racer_generated ps2_runtime rr_iop47i)
    ps2x_stage_ffmpeg_runtime_dlls(racer_iop47i_fixed_probe)
endif()

target_include_directories(rr_iop47i PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../src/core")
add_executable(racer_iop47i_import_cache "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_import_cache47i.cpp")
target_include_directories(racer_iop47i_import_cache PRIVATE "${rr_iop47i}/src")
target_link_libraries(racer_iop47i_import_cache PRIVATE rr_iop47i)
