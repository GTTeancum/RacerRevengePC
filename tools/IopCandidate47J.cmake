set(rr_iop47j "${CMAKE_CURRENT_LIST_DIR}/../build/iop47J")
file(READ "${rr_iop47j}/CMakeLists.txt" rr_iop47j_cmake)
string(REGEX MATCHALL "src/[A-Za-z0-9_/]+[.]cpp" rr_iop47j_sources "${rr_iop47j_cmake}")
list(REMOVE_DUPLICATES rr_iop47j_sources)
list(LENGTH rr_iop47j_sources rr_iop47j_count)
if(NOT rr_iop47j_count EQUAL 24)
    message(FATAL_ERROR "IOP clone must contain exactly the original 24 implementation files")
endif()
list(TRANSFORM rr_iop47j_sources PREPEND "${rr_iop47j}/")
add_library(rr_iop47j OBJECT ${rr_iop47j_sources})
target_compile_features(rr_iop47j PUBLIC cxx_std_20)
target_include_directories(rr_iop47j PUBLIC "${rr_iop47j}/include" PRIVATE "${rr_iop47j}/src" "${CMAKE_CURRENT_LIST_DIR}/../src/core")
if(TARGET ps2_iop)
    target_compile_options(rr_iop47j PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_OPTIONS>")
    target_compile_definitions(rr_iop47j PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_DEFINITIONS>")
elseif(MSVC)
    target_compile_options(rr_iop47j PRIVATE /O2 /EHsc)
    target_compile_definitions(rr_iop47j PRIVATE PS2X_ENABLE_IOP_RPC_TRACE=1)
endif()
add_executable(racer_iop47j_differential "${rr_iop47j}/differential47j.cpp")
target_include_directories(racer_iop47j_differential PRIVATE "${rr_iop47j}/src" "${rr_iop47j}/src/emulator" "${rr_iop47j}/tests")
target_link_libraries(racer_iop47j_differential PRIVATE rr_iop47j)
add_executable(racer_iop47j_scheduler "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_scheduler47g.cpp")
target_include_directories(racer_iop47j_scheduler PRIVATE "${rr_iop47j}/src")
target_link_libraries(racer_iop47j_scheduler PRIVATE rr_iop47j)
foreach(rr_suite IN ITEMS emulator import import_version compatibility)
    add_executable(racer_iop47j_${rr_suite} "${rr_iop47j}/tests/iop_${rr_suite}_tests.cpp")
    target_include_directories(racer_iop47j_${rr_suite} PRIVATE "${rr_iop47j}/src")
    target_link_libraries(racer_iop47j_${rr_suite} PRIVATE rr_iop47j)
endforeach()
if(TARGET ps2_runtime)
    add_executable(racer_iop47j_fixed_probe "${RACER_PROJECT_DIR}/src/probe.cpp"
        "${RR_SHARED_ROOT}/build/fixed47F/EeScheduler.cpp")
    target_include_directories(racer_iop47j_fixed_probe PRIVATE
        "${RR_SHARED_ROOT}/src/legacy" "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib"
        "${CMAKE_SOURCE_DIR}/ps2xRuntime/src/lib/Kernel")
    target_link_libraries(racer_iop47j_fixed_probe PRIVATE racer_generated ps2_runtime rr_iop47j)
    ps2x_stage_ffmpeg_runtime_dlls(racer_iop47j_fixed_probe)
endif()

target_include_directories(rr_iop47j PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../src/core")
add_executable(racer_iop47j_import_cache "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_import_cache47i.cpp")
target_include_directories(racer_iop47j_import_cache PRIVATE "${rr_iop47j}/src")
target_link_libraries(racer_iop47j_import_cache PRIVATE rr_iop47j)

add_executable(racer_iop47j_memory "${CMAKE_CURRENT_LIST_DIR}/../tests/iop_ownership47j.cpp" "${rr_iop47j}/memory_reference47j.cpp")
target_include_directories(racer_iop47j_memory PRIVATE "${rr_iop47j}" "${rr_iop47j}/src")
target_link_libraries(racer_iop47j_memory PRIVATE rr_iop47j)
