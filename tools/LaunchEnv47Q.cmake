set(rr_iop47q "${RR_SHARED_ROOT}/build/iop47Q")
file(READ "${rr_iop47q}/CMakeLists.txt" rr_iop47q_cmake)
string(REGEX MATCHALL "src/[A-Za-z0-9_/]+[.]cpp" rr_iop47q_sources "${rr_iop47q_cmake}")
list(REMOVE_DUPLICATES rr_iop47q_sources)
list(LENGTH rr_iop47q_sources rr_iop47q_count)
if(NOT rr_iop47q_count EQUAL 24)
    message(FATAL_ERROR "IOP clone must have exactly 24 implementation files")
endif()
list(TRANSFORM rr_iop47q_sources PREPEND "${rr_iop47q}/")
add_library(rr_iop47q OBJECT ${rr_iop47q_sources})
target_compile_features(rr_iop47q PUBLIC cxx_std_20)
target_include_directories(rr_iop47q PUBLIC "${rr_iop47q}/include" "${RR_SHARED_ROOT}/src/legacy" PRIVATE "${rr_iop47q}/src" "${RR_SHARED_ROOT}/src/core")
target_compile_options(rr_iop47q PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_OPTIONS>")
target_compile_definitions(rr_iop47q PRIVATE "$<TARGET_PROPERTY:ps2_iop,COMPILE_DEFINITIONS>")
add_executable(racer_iop47q_differential "${rr_iop47q}/differential47j2.cpp")
target_include_directories(racer_iop47q_differential PRIVATE "${rr_iop47q}/src" "${rr_iop47q}/src/emulator" "${rr_iop47q}/tests" "${RR_SHARED_ROOT}/src/core")
target_link_libraries(racer_iop47q_differential PRIVATE rr_iop47q)
include("${rr_iop47q}/Probe.cmake")
target_link_options(racer_launch47q_fixed_probe PRIVATE "/MAP:${rr_iop47q}/native.map")
